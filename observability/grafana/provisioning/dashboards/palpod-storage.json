{
  "annotations": { "list": [] },
  "description": "ZFS + NVMe health: pool used/free, snapshots, disk latency, throughput, scrub status.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "ZFS pool capacity",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Per-pool used vs. free (bytes)",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "node_zfs_zpool_allocated_bytes",
          "legendFormat": "used {{zpool}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "node_zfs_zpool_free_bytes",
          "legendFormat": "free {{zpool}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "used.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#22d3ee" } } ] },
          { "matcher": { "id": "byRegexp", "options": "free.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#34d399" } } ] }
        ]
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true } }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Pool capacity used (%)",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * node_zfs_zpool_allocated_bytes / (node_zfs_zpool_allocated_bytes + node_zfs_zpool_free_bytes)",
          "legendFormat": "{{zpool}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#22d3ee", "value": null },
              { "color": "#f59e0b", "value": 75 },
              { "color": "#ef4444", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true } }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Snapshots",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Snapshot count (all pools)",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(node_zfs_zpool_dataset_snapshot_count)", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#22d3ee" } }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total snapshot size",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(node_zfs_zpool_dataset_snapshot_used_bytes)", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "#22d3ee" } }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Disk performance",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Disk read/write latency (avg seconds per op)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_time_seconds_total[5m]) / (rate(node_disk_reads_completed_total[5m]) > 0)",
          "legendFormat": "read {{device}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_write_time_seconds_total[5m]) / (rate(node_disk_writes_completed_total[5m]) > 0)",
          "legendFormat": "write {{device}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk throughput (bytes/sec)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total[5m])",
          "legendFormat": "read {{device}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total[5m])",
          "legendFormat": "write {{device}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Scrub status (0 = idle, 1 = scrubbing, 2 = errors)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "node_zfs_zpool_scan_status", "legendFormat": "{{zpool}}", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "idle", "color": "#22d3ee" }, "1": { "text": "scrubbing", "color": "#f59e0b" }, "2": { "text": "errors", "color": "#ef4444" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#22d3ee", "value": null }, { "color": "#f59e0b", "value": 1 }, { "color": "#ef4444", "value": 2 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "graphMode": "none", "colorMode": "background", "textMode": "value_and_name" }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["palpod", "storage", "zfs"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PALPod OS — Storage health",
  "uid": "palpod-storage",
  "version": 1,
  "weekStart": ""
}
