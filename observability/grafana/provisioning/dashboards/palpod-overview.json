    {
      "id": 14,
      "type": "row",
      "title": "Household activity",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Total media library size",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(node_filesystem_size_bytes{mountpoint=~\"/data/(movies|tv|music|audiobooks|podcasts)\"} - node_filesystem_avail_bytes{mountpoint=~\"/data/(movies|tv|music|audiobooks|podcasts)\"})",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Active users online",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "palweb_active_sessions", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Extender heartbeats (last 5m)",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(palweb_extender_heartbeats_total[5m]))", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Host resource utilization",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 15, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "CPU utilization",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Memory utilization",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
