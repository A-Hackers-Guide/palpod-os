{
  "annotations": { "list": [] },
  "description": "Concurrent streams, active playback sessions, xTeVe channel demand, bandwidth by service.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Concurrent playback",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Plex — concurrent streams",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "palweb_media_sessions{service=\"plex\"}", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jellyfin — concurrent streams",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "palweb_media_sessions{service=\"jellyfin\"}", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Audiobookshelf — active playback",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "palweb_media_sessions{service=\"audiobookshelf\"}", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Live TV and game streaming",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "xTeVe — top 10 channels by demand",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (channel) (increase(palweb_xteve_channel_tunes_total[1h])))",
          "legendFormat": "{{channel}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Sunshine — active game-stream sessions",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "palweb_media_sessions{service=\"sunshine\"}", "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "#22d3ee", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Bandwidth",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Bandwidth per streaming service (bytes/sec)",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=~\"plex|jellyfin|audiobookshelf|xteve|sunshine\"}[5m]))",
          "legendFormat": "{{name}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "plex" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#22d3ee" } } ] },
          { "matcher": { "id": "byName", "options": "jellyfin" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#a78bfa" } } ] },
          { "matcher": { "id": "byName", "options": "audiobookshelf" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#f59e0b" } } ] },
          { "matcher": { "id": "byName", "options": "xteve" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#34d399" } } ] },
          { "matcher": { "id": "byName", "options": "sunshine" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#f472b6" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["palpod", "media"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PALPod OS — Media servers",
  "uid": "palpod-media",
  "version": 1,
  "weekStart": ""
}
