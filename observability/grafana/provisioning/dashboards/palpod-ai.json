{
  "annotations": { "list": [] },
  "description": "PAL Voice AI performance: LLM latency, tokens/sec, ensemble presenter selection, STT/TTS latency, wake-word events.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "LLM inference",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM latency (p50 / p95 / p99) by model",
      "gridPos": { "x": 0, "y": 1, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(palvoice_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{model}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(palvoice_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{model}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(palvoice_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{model}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "p50.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#22d3ee" } } ] },
          { "matcher": { "id": "byRegexp", "options": "p95.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#f59e0b" } } ] },
          { "matcher": { "id": "byRegexp", "options": "p99.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ef4444" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per second by model",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(palvoice_llm_tokens_total[5m]))",
          "legendFormat": "{{model}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Ensemble presenter selection — how often each model presents",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(palvoice_ensemble_presenter_total[24h]))",
          "legendFormat": "{{model}}",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true, "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true } }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Ensemble consensus health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Gross divergence detections over time",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(palvoice_ensemble_divergence_total[15m]))",
          "legendFormat": "divergences / sec",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum(rate(palvoice_ensemble_prompts_total[15m]))",
          "legendFormat": "prompts / sec",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "divergences / sec" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ef4444" } } ] },
          { "matcher": { "id": "byName", "options": "prompts / sec" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#22d3ee" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Speech pipeline latency",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "histogram",
      "title": "STT (Whisper) latency histogram",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(palvoice_stt_latency_seconds_bucket[1h]))",
          "format": "heatmap",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "custom": { "fillOpacity": 80, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "bucketOffset": 0, "combine": false, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 9,
      "type": "histogram",
      "title": "TTS (Piper) synthesis latency histogram",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (increase(palvoice_tts_latency_seconds_bucket[1h]))",
          "format": "heatmap",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" },
          "custom": { "fillOpacity": 80, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": { "bucketOffset": 0, "combine": false, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Wake word",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Wake word triggers per hour (true / false / cancelled)",
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(palvoice_wake_events_total{outcome=\"true_positive\"}[1h])) * 3600",
          "legendFormat": "true positive",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum(rate(palvoice_wake_events_total{outcome=\"false_positive\"}[1h])) * 3600",
          "legendFormat": "false positive",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "C",
          "expr": "sum(rate(palvoice_wake_events_total{outcome=\"cancelled\"}[1h])) * 3600",
          "legendFormat": "cancelled",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "true positive" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#22d3ee" } } ] },
          { "matcher": { "id": "byName", "options": "false positive" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#ef4444" } } ] },
          { "matcher": { "id": "byName", "options": "cancelled" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#f59e0b" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["palpod", "ai", "voice"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PALPod OS — AI performance",
  "uid": "palpod-ai",
  "version": 1,
  "weekStart": ""
}
