{
  "annotations": { "list": [] },
  "description": "Postgres 16 health: connections, query latency, buffer cache hit ratio, replication lag, disk usage.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Connections",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(pg_stat_activity_count)", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#22d3ee", "value": null }, { "color": "#f59e0b", "value": 80 }, { "color": "#ef4444", "value": 95 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Max connections",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "pg_settings_max_connections", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "#22d3ee" } }, "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Buffer cache hit ratio",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))",
          "instant": true,
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "#f59e0b", "value": 0.9 }, { "color": "#22d3ee", "value": 0.98 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB size (all databases)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(pg_database_size_bytes)", "instant": true, "datasource": { "type": "prometheus", "uid": "palpod-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "fixed", "fixedColor": "#22d3ee" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections over time (by state)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (pg_stat_activity_count)",
          "legendFormat": "{{state}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Query latency proxy — average tuple return + fetch rate",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_tup_returned[5m]))",
          "legendFormat": "returned {{datname}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_tup_fetched[5m]))",
          "legendFormat": "fetched {{datname}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["last", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Replication lag (seconds behind primary)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_replication_lag",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#22d3ee", "value": null }, { "color": "#f59e0b", "value": 5 }, { "color": "#ef4444", "value": 30 } ] },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Deadlocks + conflicts",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "palpod-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_deadlocks[5m]))",
          "legendFormat": "deadlocks {{datname}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_conflicts[5m]))",
          "legendFormat": "conflicts {{datname}}",
          "datasource": { "type": "prometheus", "uid": "palpod-prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["palpod", "postgres"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "PALPod OS — Postgres health",
  "uid": "palpod-postgres",
  "version": 1,
  "weekStart": ""
}
