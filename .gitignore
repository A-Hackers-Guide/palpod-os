docker-compose.override.yml

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log
logs/

# Postgres dumps we generate ad-hoc
*.sql.gz
*.dump

# Sibling repo checkouts (mounted into containers)
/pal-web/
/pal-voice/
/pal-face/
