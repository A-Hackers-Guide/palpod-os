# ──────────────────────────────────────────────────────────────────────────────
# PALPod OS — environment configuration
#
# Copy this file to `.env` (install.sh does this for you) and fill in the
# blanks. Every variable is consumed by docker-compose.yml or by one of the
# scripts under scripts/.
#
# Values marked <REQUIRED> must be set before `docker compose up`.
# Values marked <optional> may be left as-is for a working single-node MVP.
# ──────────────────────────────────────────────────────────────────────────────

# --- Locale & identity --------------------------------------------------------
# The Pod's hostname on the LAN. Also used as the CN on the self-signed root.
PALPOD_HOSTNAME=palpod
# System timezone (used by every container that respects TZ).
TZ=America/Los_Angeles
# PUID/PGID for the media containers. Match the owning user on the host so
# bind-mounted media directories are readable/writable. `id -u` / `id -g`.
PUID=1000
PGID=1000

# --- Storage paths ------------------------------------------------------------
# Root of all persistent data. On Ubuntu this is a plain directory; on
# TrueNAS the first-boot script creates a ZFS dataset at this path.
PALPOD_DATA_ROOT=/var/lib/palpod

# Media libraries. Point these at wherever your media actually lives.
MEDIA_MOVIES=/mnt/media/movies
MEDIA_TV=/mnt/media/tv
MEDIA_MUSIC=/mnt/media/music
MEDIA_AUDIOBOOKS=/mnt/media/audiobooks
MEDIA_PODCASTS=/mnt/media/podcasts

# --- Sibling repo checkout paths (mounted into containers) --------------------
# The other agents' repos. Adjust if your checkout layout differs.
PAL_WEB_PATH=../pal-web
PAL_VOICE_PATH=../pal-voice
PAL_FACE_PATH=../pal-face

# --- Plex ---------------------------------------------------------------------
# <REQUIRED for first boot only> Get a claim token from https://plex.tv/claim
# (valid for 4 minutes). Leave blank after the server is claimed.
PLEX_CLAIM=
# The URL Plex will advertise. Usually leave blank and let Plex auto-detect.
PLEX_ADVERTISE_IP=

# --- Jellyfin -----------------------------------------------------------------
JELLYFIN_PUBLISHED_URL=https://jelly.palpod.local

# --- xTeVe (M3U/EPG proxy) ----------------------------------------------------
# Fill these in the xTeVe web UI on first launch, or seed configs/xteve/config.yaml.
XTEVE_M3U_URL=
XTEVE_EPG_URL=

# --- Sunshine (game/desktop streaming) ----------------------------------------
# Web UI credentials for first-time pairing.
SUNSHINE_ADMIN_USER=admin
SUNSHINE_ADMIN_PASSWORD=change-me-immediately

# --- Steam headless -----------------------------------------------------------
# The Steam account used inside the headless container. SteamGuard code will
# be requested interactively the first time — see configs/steam-headless/README.md.
STEAM_USERNAME=
STEAM_PASSWORD=

# --- Postgres -----------------------------------------------------------------
POSTGRES_DB=palpod
POSTGRES_USER=palpod
# <REQUIRED> — install.sh will generate one if left blank.
POSTGRES_PASSWORD=

# --- pal-web ------------------------------------------------------------------
# JWT secret used to sign extender-pairing tokens and web sessions.
# install.sh generates a strong random value if left blank.
PAL_WEB_JWT_SECRET=
# Shared secret extenders must present at /api/pair. Rotate at will.
PAL_EXTENDER_SHARED_SECRET=

# --- pal-voice ----------------------------------------------------------------
# Path to the local LLM weights (mounted read-only into the voice container).
PAL_VOICE_MODEL_DIR=/var/lib/palpod/models

# --- Traefik ------------------------------------------------------------------
# Root domain served on the LAN. All service subdomains hang off this.
PALPOD_DOMAIN=palpod.local
# Where Traefik writes its self-signed root & per-host certs.
TRAEFIK_CERT_DIR=/var/lib/palpod/traefik/certs
