# PAL Face Renderer — configuration
# Copy to config.yaml and edit for your hardware.

# --- Display -----------------------------------------------------------------
screen:
  # Waveshare 8" Round IPS is 1080x1080. Set to your panel's native resolution.
  width: 1080
  height: 1080
  # Fraction of min(width,height)/2 used as the face's "sphere" radius.
  # Content outside this circle is masked so square debug displays look round.
  sphere_radius_frac: 0.98
  # Show a fullscreen window. Set false for a windowed debug run.
  fullscreen: true
  # SDL driver override (leave null to autodetect).
  # For Jetson kiosk: sdl_driver: "kmsdrm" (or "fbcon" with fb_device: /dev/fb0)
  sdl_driver: null
  fb_device: null
  # Target framerate. 60 for OLED, higher only if the panel supports it.
  target_fps: 60
  # Enable vsync when supported by SDL.
  vsync: true

# --- WebSocket bridge --------------------------------------------------------
bridge:
  # pal-voice orchestrator address.
  url: "ws://localhost:7777"
  # Reconnect settings (exponential backoff, capped).
  reconnect_initial_seconds: 0.5
  reconnect_max_seconds: 30.0
  # If true, run without ever attempting a WebSocket connection (pure idle).
  offline: false

# --- Animation ---------------------------------------------------------------
animation:
  # Duration (ms) of a state-to-state morph. easeInOutCubic.
  state_transition_ms: 350
  # Subtle bob to imply the sphere floats.
  bob_amplitude_px: 6
  bob_period_seconds: 3.4
  # Blink cadence (uniform random in this window). Seconds between blinks.
  blink_interval_min: 4.0
  blink_interval_max: 6.5
  # A single blink close+open (ms).
  blink_duration_ms: 120
  # Idle glance behavior.
  glance_interval_min: 6.0
  glance_interval_max: 14.0
  glance_offset_frac: 0.06
  glance_duration_ms: 800
  # Random micro-expression burst while idle (NEUTRAL only).
  idle_expression_interval_min: 5.0
  idle_expression_interval_max: 12.0
  idle_expression_hold_ms_min: 900
  idle_expression_hold_ms_max: 1800
  # Micro-expressions to sample from during idle.
  idle_expressions: ["HAPPY", "WINK", "SURPRISED", "SUSPICIOUS", "THINKING"]

# --- Debug -------------------------------------------------------------------
debug:
  # Show FPS in top-left (only visible on square debug displays).
  show_fps: false
  # Draw the sphere mask outline in magenta.
  show_mask: false
